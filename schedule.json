    "p5": {
      "name": "John Monteleone",
      "links": [
        {
          "service": "website",
          "url": "https://www.monteleone.net/",
          "label": "Website"
        }
      ],
      "bio": "Recognized as one of the finest living archtop guitar and mandolin makers in the world today, Monteleone has been at the forefront of innovative archtop instrument making for many years. A resident of Islip, New York, he has been pushing the luthier envelope for more than 40 years with new and elegant designs."
