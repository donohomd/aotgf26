    "p14": {
      "name": "John D’Angelico",
      "bio": "New York archtop maker (1905–1964). He learned the trade as a boy in his great-uncle Raphael Ciani’s shop in Little Italy and opened his own at 40 Kenmare Street in 1932, building roughly 1,200 instruments in an Art Deco style all his own; the New Yorker became his flagship. His apprentice James D’Aquisto carried on his work."
    },
    "p15": {
      "name": "Cris Mirabella",
      "links": [
        {
          "service": "website",
          "url": "https://www.mirabellaguitars.com/",
          "label": "Website"
        },
        {
          "service": "instagram",
          "url": "https://www.instagram.com/mirabellaguitars/",
          "label": "Instagram"
        },
        {
          "service": "facebook",
          "url": "https://www.facebook.com/Mirabellaguitar/",
          "label": "Facebook"
        }
      ],
      "bio": "Long Island archtop maker who apprenticed for some fifteen years among New York builders and players, influenced by James D’Aquisto and John Monteleone, before opening Mirabella Guitars and Restorations in 1997. Known for his archtops, among them the Trap Door, and for restoring D’Angelico, D’Aquisto and golden-era Gibson and Epiphone guitars."
    },
    "p16": {
      "name": "Manzer Guitars",
      "links": [
        {
          "service": "website",
          "url": "https://manzer.com/",
          "label": "Website"
        }
      ],
      "bio": "The workshop of Canadian luthier Linda Manzer, who trained with Jean Larrivée and with James D’Aquisto and builds a small number of archtop, flattop and harp guitars by hand each year. Her guitars are played by Pat Metheny, for whom she built the 42-string Pikasso, Bruce Cockburn and Julian Lage. She is an Officer of the Order of Canada."
    }
